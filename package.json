{
  "name": "rondo",
  "main": "main.js",
  "type": "module",
  "version": "1.1.0",
  "description": "A lightweight YouTube music widget for the desktop",
  "author": "HexaNexus",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build && electron-builder",
    "start": "vite build && electron .",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.hexanexus.rondo",
    "productName": "Rondo",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.cjs",
      "electron/**/*",
      "src/assets/icons/my-icon.ico"
    ],
    "publish": {
      "provider": "github",
      "owner": "HexaNexus28",
      "repo": "Rondo"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icons/my-icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "vite": "^7.1.7"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:react-hooks/recommended"
    ],
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  }
}
